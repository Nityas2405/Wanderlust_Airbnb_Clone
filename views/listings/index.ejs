<% layout("/layouts/boilerplate") %>

<style>
  #filters-container {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: 1.5rem;
  }

  #filters {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 2rem;
    row-gap: 1rem;
  }

  .filter-link {
    text-decoration: none;
    color: inherit;
  }

  .filter-link:hover {
    text-decoration: none;
    color: inherit;
  }

  .filter {
    text-align: center;
    opacity: 0.7;
    transition: opacity 0.2s ease, transform 0.2s ease;
    cursor: pointer;
  }

  .filter:hover {
    opacity: 1;
    transform: translateY(-2px);
  }

  .filter i {
    font-size: 1.25rem;
  }

  .filter p {
    font-size: 0.8rem;
    margin-top: 0.35rem;
    margin-bottom: 0;
  }

  .tax-info {
    display: none;
  }

  .tax-toggle {
    border: 1px solid #d3d3d3;
    border-radius: 1rem;
    height: 3.25rem;
    padding: 0.75rem 1rem;
    display: flex;
    align-items: center;
    white-space: nowrap;
  }

  .listing-card {
    border: none !important;
    margin-bottom: 2rem;
  }

</style>

<!-- Filters and Tax Toggle Container -->
<div id="filters-container" >
  <div id="filters" class="d-flex align-items-center mt-3">
    <a href="/listings/filter/Rooms" class="filter-link">
      <div class="filter">
        <div><i class="fa-solid fa-bed"></i></div>
        <p>Rooms</p>
      </div>
    </a>

    <a href="/listings/filter/Iconic-cities" class="filter-link">
      <div class="filter">
        <div><i class="fa-solid fa-mountain-city"></i></div>
        <p>Iconic cities</p>
      </div>
    </a>

    <a href="/listings/filter/Mountains" class="filter-link">
      <div class="filter">
        <div><i class="fa-solid fa-mountain"></i></div>
        <p>Mountains</p>
      </div>
    </a>

    <a href="/listings/filter/Castles" class="filter-link">
      <div class="filter">
        <div><i class="fa-brands fa-fort-awesome"></i></div>
        <p>Castles</p>
      </div>
    </a>

    <a href="/listings/filter/Amazing-pools" class="filter-link">
      <div class="filter">
        <div><i class="fa-solid fa-person-swimming"></i></div>
        <p>Amazing pools</p>
      </div>
    </a>

    <a href="/listings/filter/Camping" class="filter-link">
      <div class="filter">
        <div><i class="fa-solid fa-campground"></i></div>
        <p>Camping</p>
      </div>
    </a>

    <a href="/listings/filter/Farms" class="filter-link">
      <div class="filter">
        <div><i class="fa-solid fa-cow"></i></div>
        <p>Farms</p>
      </div>
    </a>

    <a href="/listings/filter/Arctic" class="filter-link">
      <div class="filter">
        <div><i class="fa-regular fa-snowflake"></i></div>
        <p>Arctic</p>
      </div>
    </a>

    <a href="/listings/filter/Domes" class="filter-link">
      <div class="filter">
        <div><i class="fa-solid fa-igloo"></i></div>
        <p>Domes</p>
      </div>
    </a>

    <a href="/listings/filter/Boats" class="filter-link">
      <div class="filter">
        <div><i class="fa-solid fa-ship"></i></div>
        <p>Boats</p>
      </div>
    </a>
  </div>

  <div class="tax-toggle">
    <div class="form-check-reverse form-switch">
      <input class="form-check-input" type="checkbox" role="switch" id="switchCheckDefault">
      <label class="form-check-label" for="switchCheckDefault">Display Total after Taxes</label>
    </div>
  </div>
</div>

<!-- Listing Cards Grid -->
<div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 mt-3 ">
  <% for(let listing of allListings) { %>
    <a href="/listings/<%= listing._id %>" class="listing-link col">
      <div class="card listing-card">
        <img 
          src="<%= listing.image.url %>" 
          class="card-img-top" 
          alt="listing_image" 
          style="height: 20rem; object-fit: cover; border-radius: 1rem;"
        />

        <div class="card-body px-0">
          <p class="card-text">
            <b><%= listing.title %></b><br />
            &#8377;<%= listing.price.toLocaleString("en-IN") %>/night
            <i class="tax-info">&nbsp; &nbsp; +18% GST</i>
          </p>
        </div>
      </div>
    </a>
  <% } %>
</div>

<script>
  const taxSwitch = document.getElementById("switchCheckDefault");
  taxSwitch.addEventListener("click", () => {
    const taxInfo = document.getElementsByClassName("tax-info");
    for (let info of taxInfo) {
      if (info.style.display !== "inline") {
        info.style.display = "inline";
      } else {
        info.style.display = "none";
      }
    }
  });
</script>